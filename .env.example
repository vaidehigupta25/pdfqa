# Copy to .env and edit. No real secrets are committed in this repo.

# Two demo users (API keys are demo placeholders - change them if you like)
ALICE_API_KEY=alice-demo-key-change-me
BOB_API_KEY=bob-demo-key-change-me

# LLM: gemini | groq | ollama | extractive (offline, no key, rule-based - for testing only)
LLM_PROVIDER=gemini
LLM_API_KEY=api-key
# Model names change often - check your provider's current free model list.
LLM_MODEL=LLM_MODEL=gemini-3.1-flash-lite
# LLM_BASE_URL=            # optional override; sensible default per provider

# Embeddings: fastembed (local, free, ~90MB first-run download) | hash (offline, no download, test only)
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Minimum cosine similarity for a chunk to be considered relevant (tune with eval/run_eval.py)
# MIN_SIMILARITY=0.25

MAX_UPLOAD_MB=20
